# From Supabase → Project Settings → API Keys (and Data API for the URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). Safe in the browser: row-level security decides what it can see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_…). Server only — used to create and remove staff accounts,
# and by the two setup scripts. Never commit it or put it in the website.
SUPABASE_SECRET_KEY=
